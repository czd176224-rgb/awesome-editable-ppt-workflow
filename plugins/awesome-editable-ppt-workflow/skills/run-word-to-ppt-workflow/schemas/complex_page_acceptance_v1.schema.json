{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_page_acceptance_v1.schema.json",
  "title": "Awesome complex-page accepted image seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "experiment_id", "page_number",
    "source_snapshot_sha256", "source_identity", "ui_revision", "ui_digest",
    "material_view_sha256", "page_plan", "candidate", "candidate_history_sha256",
    "prompt_history_sha256", "selected_real_reference_ids", "accepted_review",
    "provider_authority", "fixed_frame", "evidence_checkpoint", "key_id",
    "hmac_sha256"
  ],
  "properties": {
    "schema_version": {"const": "awesome-complex-page-acceptance-v1"},
    "status": {"const": "accepted"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "page_number": {"type": "integer", "minimum": 1},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "source_identity": {"$ref": "#/$defs/sha"},
    "ui_revision": {"type": "integer", "minimum": 1},
    "ui_digest": {"$ref": "#/$defs/sha"},
    "material_view_sha256": {"$ref": "#/$defs/sha"},
    "page_plan": {"type": "object"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "path", "sha256", "byte_size", "width", "height",
                   "trace_path", "prompt_path", "operation", "quality",
                   "selected_reference_ids", "input_sha256s", "prompt_sha256",
                   "request_identity", "duration_seconds", "duration_unavailable_reason"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "byte_size": {"type": "integer", "minimum": 1},
        "width": {"const": 1904}, "height": {"const": 896},
        "trace_path": {"type": "string", "minLength": 1},
        "prompt_path": {"type": "string", "minLength": 1},
        "operation": {"enum": ["generate", "edit"]},
        "quality": {"enum": ["medium", "high"]},
        "selected_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "input_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha"}},
        "prompt_sha256": {"$ref": "#/$defs/sha"},
        "request_identity": {"$ref": "#/$defs/sha"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "duration_unavailable_reason": {"type": ["string", "null"]}
      }
    },
    "candidate_history_sha256": {"$ref": "#/$defs/sha"},
    "prompt_history_sha256": {"$ref": "#/$defs/sha"},
    "selected_real_reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reconstruction_repairs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "detail"],
        "dependentRequired": {"find": ["replace"], "replace": ["find"]},
        "properties": {
          "category": {
            "enum": [
              "fact_integrity", "primary_relationship", "core_exhibit_prominence",
              "quantitative_truth", "severe_usability"
            ]
          },
          "detail": {"type": "string", "minLength": 1},
          "find": {"type": "string", "minLength": 1, "maxLength": 100},
          "replace": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "accepted_review": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "problems", "model", "effort", "duration_seconds", "authority_path", "authority_sha256"],
      "properties": {
        "decision": {"const": "accept"},
        "problems": {"type": "array", "maxItems": 0},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": ["string", "null"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "authority_path": {"type": "string", "minLength": 1},
        "authority_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "provider_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_path", "trace_sha256", "capability_path", "capability_sha256",
                   "capability_nonce", "journal_path", "journal_sha256", "request_identity"],
      "properties": {
        "trace_path": {"type": "string", "minLength": 1}, "trace_sha256": {"$ref": "#/$defs/sha"},
        "capability_path": {"type": "string", "minLength": 1}, "capability_sha256": {"$ref": "#/$defs/sha"},
        "capability_nonce": {"type": "string", "minLength": 1},
        "journal_path": {"type": "string", "minLength": 1}, "journal_sha256": {"$ref": "#/$defs/sha"},
        "request_identity": {"$ref": "#/$defs/sha"}
      }
    },
    "fixed_frame": {"type": "object"},
    "evidence_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "experiment_id", "workspace_identity_sha256", "source_snapshot_sha256", "page_number", "selected_attempt", "candidate_sha256", "request_identity", "review_authority_sha256", "event_count", "terminal_event_index", "evidence_prefix_sha256", "causal_events", "checkpoint_sha256"],
      "properties": {
        "schema_version": {"const": "awesome-complex-page-candidate-acceptance-checkpoint-v1"},
        "experiment_id": {"type": "string", "minLength": 1},
        "workspace_identity_sha256": {"$ref": "#/$defs/sha"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
        "page_number": {"type": "integer", "minimum": 1},
        "selected_attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "candidate_sha256": {"$ref": "#/$defs/sha"},
        "request_identity": {"$ref": "#/$defs/sha"},
        "review_authority_sha256": {"$ref": "#/$defs/sha"},
        "event_count": {"type": "integer", "minimum": 3, "maximum": 64},
        "terminal_event_index": {"type": "integer", "minimum": 2, "maximum": 63},
        "evidence_prefix_sha256": {"$ref": "#/$defs/sha"},
        "causal_events": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["event_index", "value"],
            "properties": {"event_index": {"type": "integer", "minimum": 0, "maximum": 63}, "value": {"type": "object"}}
          }
        },
        "checkpoint_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "key_id": {"type": "string", "minLength": 1},
    "hmac_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
