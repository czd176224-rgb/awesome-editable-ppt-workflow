{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_page_review_v1.schema.json",
  "title": "Awesome independent visual review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "problems"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "awesome-independent-visual-review-v1"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "correct"
      ]
    },
    "problems": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "detail"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "fact_integrity",
              "primary_relationship",
              "core_exhibit_prominence",
              "quantitative_truth",
              "severe_usability"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
