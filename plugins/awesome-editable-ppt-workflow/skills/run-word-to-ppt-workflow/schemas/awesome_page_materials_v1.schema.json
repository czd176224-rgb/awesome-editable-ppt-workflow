{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awesome_page_materials_v1.schema.json",
  "title": "AwesomePageMaterialsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page_number",
    "fixed_page_title",
    "complete_word_content",
    "original_comments",
    "word_images",
    "attachment_inputs",
    "visual_contract",
    "body_frame"
  ],
  "properties": {
    "page_number": {"type": "integer", "minimum": 1},
    "fixed_page_title": {"type": "string", "minLength": 1},
    "complete_word_content": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceBlock"}
    },
    "original_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comment_id", "source_order", "text"],
        "properties": {
          "comment_id": {"type": "string"},
          "source_order": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "word_images": {"$ref": "#/$defs/sourceInputs"},
    "attachment_inputs": {"$ref": "#/$defs/sourceInputs"},
    "visual_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_color", "secondary_color", "background_color", "cjk_font", "latin_font", "title_size_pt", "body_size_pt", "caption_size_pt", "regional_characteristics", "visual_description"],
      "properties": {
        "primary_color": {"type": "string"},
        "secondary_color": {"type": "string"},
        "background_color": {"type": "string"},
        "cjk_font": {"type": "string"},
        "latin_font": {"type": "string"},
        "title_size_pt": {"type": "number"},
        "body_size_pt": {"type": "number"},
        "caption_size_pt": {"type": "number"},
        "regional_characteristics": {"type": "string"},
        "visual_description": {"type": "string"}
      }
    },
    "body_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_version", "body_bounds_cm", "body_pixels", "fixed_layers"],
      "properties": {
        "geometry_version": {"const": "fixed-canvas-cm-v2"},
        "body_bounds_cm": {"type": "object", "required": ["x", "y", "w", "h"], "additionalProperties": {"type": "number"}},
        "body_pixels": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"const": 1904}, "height": {"const": 896}}},
        "fixed_layers": {"const": ["title", "logo", "footer", "page_number"]}
      }
    }
  },
  "$defs": {
    "sourceCommon": {
      "type": "object",
      "required": ["type", "source_block_id", "source_block_index", "source_order", "relationship_ids", "comment_ids"],
      "properties": {
        "type": {"enum": ["paragraph", "list", "table"]},
        "source_block_id": {"type": "string", "minLength": 1},
        "source_block_index": {"type": "integer", "minimum": 0},
        "source_order": {"type": "integer", "minimum": 1},
        "relationship_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "comment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "sourceBlock": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/sourceCommon"}, {"type": "object", "additionalProperties": false, "required": ["type", "text", "source_block_id", "source_block_index", "source_order", "relationship_ids", "comment_ids"], "properties": {"type": {"const": "paragraph"}, "text": {"type": "string"}, "source_block_id": {"type": "string"}, "source_block_index": {"type": "integer"}, "source_order": {"type": "integer"}, "relationship_ids": {"type": "array", "items": {"type": "string"}}, "comment_ids": {"type": "array", "items": {"type": "string"}}}}]},
        {"allOf": [{"$ref": "#/$defs/sourceCommon"}, {"type": "object", "additionalProperties": false, "required": ["type", "text", "list_kind", "level", "source_block_id", "source_block_index", "source_order", "relationship_ids", "comment_ids"], "properties": {"type": {"const": "list"}, "text": {"type": "string"}, "list_kind": {"enum": ["bullet", "number"]}, "level": {"type": "integer", "minimum": 0}, "source_block_id": {"type": "string"}, "source_block_index": {"type": "integer"}, "source_order": {"type": "integer"}, "relationship_ids": {"type": "array", "items": {"type": "string"}}, "comment_ids": {"type": "array", "items": {"type": "string"}}}}]},
        {"allOf": [{"$ref": "#/$defs/sourceCommon"}, {"type": "object", "additionalProperties": false, "required": ["type", "rows", "source_block_id", "source_block_index", "source_order", "relationship_ids", "comment_ids"], "properties": {"type": {"const": "table"}, "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "source_block_id": {"type": "string"}, "source_block_index": {"type": "integer"}, "source_order": {"type": "integer"}, "relationship_ids": {"type": "array", "items": {"type": "string"}}, "comment_ids": {"type": "array", "items": {"type": "string"}}}}]}
      ]
    },
    "sourceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "source_order", "original_filename", "media_type", "path", "sha256", "byte_size"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "source_order": {"type": "integer", "minimum": 1},
          "original_filename": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0},
          "render_receipt": {"$ref": "#/$defs/attachmentRenderReceipt"}
        }
      }
    },
    "renderedImage": {
      "type": "object", "additionalProperties": false,
      "required": ["page_number", "path", "width", "height", "byte_size", "sha256"],
      "properties": {
        "page_number": {"type": "integer", "minimum": 0}, "path": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "byte_size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "attachmentRenderReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "original_path", "original_sha256", "original_byte_size", "renderer_identity", "pages", "contact_sheet"],
      "properties": {
        "schema_version": {"const": "awesome-attachment-render-v1"}, "original_path": {"type": "string", "minLength": 1},
        "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "original_byte_size": {"type": "integer", "minimum": 0},
        "renderer_identity": {"type": "string", "minLength": 1},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderedImage"}},
        "contact_sheet": {"$ref": "#/$defs/renderedImage"}
      }
    }
  }
}
