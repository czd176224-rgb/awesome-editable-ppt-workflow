{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.com/schemas/awesome-editable-ppt-workflow/confirmed-visual-contract-v1.json",
  "title": "ConfirmedVisualContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "revision",
    "primary_color",
    "secondary_color",
    "background_color",
    "cjk_font",
    "latin_font",
    "title_size_pt",
    "body_size_pt",
    "caption_size_pt"
  ],
  "properties": {
    "submission_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 1},
    "primary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "secondary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "highlight_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "background_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "cjk_font": {"type": "string", "minLength": 1, "maxLength": 120},
    "latin_font": {"type": "string", "minLength": 1, "maxLength": 120},
    "title_size_pt": {"type": "number", "minimum": 12, "maximum": 72},
    "body_size_pt": {"type": "number", "minimum": 8, "maximum": 32},
    "caption_size_pt": {"type": "number", "minimum": 8, "maximum": 24}
  }
}
