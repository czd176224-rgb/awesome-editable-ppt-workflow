{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/word-to-editable-ppt/source_lock.schema.json",
  "title": "Anchored page-contract source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_contract_version", "source_file", "page_count", "pages"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "workflow_contract_version": {"const": "word-ppt-workflow-v4"},
    "source_file": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page_number", "contract_file", "contract_sha256", "relationship_contract_sha256"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "contract_file": {"type": "string", "pattern": "^page_[0-9]{3,}\\.json$|^contract\\.json$"},
          "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "relationship_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
