{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/word-to-editable-ppt/page_qa.schema.json",
  "title": "Relaxed, page-local QA result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "repair_scope", "issues"],
  "properties": {
    "status": {
      "enum": ["pass", "pass_with_advisory", "repair"]
    },
    "repair_scope": {
      "enum": ["none", "local", "structural"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "severity", "trigger", "evidence", "confidence"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 280},
          "severity": {"enum": ["advisory", "local", "structural"]},
          "trigger": {"type": "string", "minLength": 1},
          "evidence": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["file", "locator", "sha256"],
                "properties": {
                  "file": {"type": "string", "minLength": 1},
                  "locator": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            ]
          },
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact", "source"],
        "properties": {
          "fact": {"type": "string", "minLength": 1},
          "source": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["file", "locator", "sha256"],
                "properties": {
                  "file": {"type": "string", "minLength": 1},
                  "locator": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            ]
          },
          "evidence_id": {"type": ["string", "null"]}
        }
      }
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "trigger_reason": {
      "type": "string",
      "minLength": 1
    },
    "checked_scope": {
      "enum": ["full", "targeted"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "repair"}}},
      "then": {
        "properties": {
          "repair_scope": {"enum": ["local", "structural"]},
          "issues": {"minItems": 1}
        }
      },
      "else": {
        "properties": {"repair_scope": {"const": "none"}}
      }
    }
  ]
}
