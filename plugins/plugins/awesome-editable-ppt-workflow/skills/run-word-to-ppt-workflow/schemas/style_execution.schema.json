{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "canvasProfile":{"type":"object","additionalProperties":false,"required":["aspect_ratio","slide_width_inches","slide_height_inches","fit","coordinate_space","allow_crop"],"properties":{"aspect_ratio":{"const":"16:9"},"slide_width_inches":{"const":10.0},"slide_height_inches":{"const":5.625196850393701},"fit":{"const":"reconstruct_to_body"},"coordinate_space":{"const":"dynamic_source_normalized"},"allow_crop":{"const":false}}},
    "bodyBounds":{"type":"object","additionalProperties":false,"required":["x","y","w","h"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
    "bodyBoundsCm":{"type":"object","additionalProperties":false,"required":["x","y","w","h"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"w":{"type":"number","exclusiveMinimum":0},"h":{"type":"number","exclusiveMinimum":0}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","canvas","canvas_profile","body_image_profile","hard_constraints","fixed_frame","soft_preferences","creative_freedom"],
  "properties":{
    "schema_version":{"const":"2.0"},
    "canvas":{"const":"ppt169"},
    "canvas_profile":{"$ref":"#/$defs/canvasProfile"},
    "body_image_profile":{"type":"object","additionalProperties":false,"required":["version","production_profile","size","ratio","mapping","direct_aspect_tolerance"],"properties":{"version":{"enum":["body-image-profile-v1","body-image-profile-v2"]},"production_profile":{"enum":["speed","balanced","quality"]},"size":{"enum":["1632x768","1904x896","2176x1024"]},"ratio":{"const":"17:8"},"mapping":{"const":"direct_then_repair"},"direct_aspect_tolerance":{"const":0.01}},"allOf":[{"if":{"properties":{"version":{"const":"body-image-profile-v2"}},"required":["version"]},"then":{"properties":{"size":{"const":"1904x896"}}}}]},
    "hard_constraints":{"type":"object","additionalProperties":false,"required":["content_fidelity","one_page_to_one_slide","title_color","palette","typography"],"properties":{"content_fidelity":{"const":"preserve_information_and_logic"},"one_page_to_one_slide":{"const":true},"title_color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},"palette":{"type":"object"},"typography":{"type":"object"}}},
    "fixed_frame":{"type":"object","additionalProperties":false,"required":["geometry_version","title_color","body_bounds_cm","body_bounds","title_bounds_cm","title_bounds","logo_bounds_cm","logo_bounds","footer_line","page_number_bounds_cm","page_number_bounds","page_number_style"],"properties":{"geometry_version":{"const":"fixed-canvas-cm-v2"},"title_color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},"body_bounds_cm":{"$ref":"#/$defs/bodyBoundsCm"},"body_bounds":{"$ref":"#/$defs/bodyBounds"},"title_bounds_cm":{"$ref":"#/$defs/bodyBoundsCm"},"title_bounds":{"$ref":"#/$defs/bodyBounds"},"logo_bounds_cm":{"$ref":"#/$defs/bodyBoundsCm"},"logo_bounds":{"$ref":"#/$defs/bodyBounds"},"footer_line":{"type":"object"},"page_number_bounds_cm":{"$ref":"#/$defs/bodyBoundsCm"},"page_number_bounds":{"$ref":"#/$defs/bodyBounds"},"page_number_style":{"type":"object"}}},
    "soft_preferences":{"type":"object","additionalProperties":false,"required":["direction","template_selection","visual_style","color","icons","typography","image_rendering","style_axes","layout_preferences","information_density","regional_style","background_system","image_role","evidence_strength","composition_tendency","brand_device","additional_requirements"],"properties":{"direction":{"type":"integer","minimum":0},"template_selection":{"type":"object"},"visual_style":{"type":"string","minLength":1},"color":{"type":"object"},"icons":{"type":"string","minLength":1},"typography":{"type":"object"},"image_rendering":{"type":"object"},"style_axes":{"type":"object"},"layout_preferences":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"information_density":{"enum":["low","balanced","high"]},"regional_style":{"type":"object"},"background_system":{"enum":["light","dark","mixed","light-with-dark-highlights"]},"image_role":{"type":"object"},"evidence_strength":{"enum":["business","data-case","strict"]},"composition_tendency":{"enum":["auto","formal-consulting","brand-editorial","technical-rd","product-launch"]},"brand_device":{"enum":["none","light","medium","strong"]},"additional_requirements":{"type":"string","maxLength":2000}}},
    "creative_freedom":{"type":"object","additionalProperties":false,"required":["layout","composition","visual_hierarchy","content_visualization","page_specific_emphasis"],"properties":{"layout":{"const":true},"composition":{"const":true},"visual_hierarchy":{"const":true},"content_visualization":{"const":true},"page_specific_emphasis":{"const":true}}}
  }
}
