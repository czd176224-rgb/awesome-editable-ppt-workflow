{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow_state_v4.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "styleExecution": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "materialRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_version", "path", "sha256"],
      "properties": {
        "artifact_version": {"const": "page-material-bundle-v4"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generationRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_version", "path", "sha256"],
      "properties": {
        "artifact_version": {"const": "page-generation-v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qaRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_version", "path", "sha256"],
      "properties": {
        "artifact_version": {"const": "page-qa-v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "editableRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_version", "path", "sha256"],
      "properties": {
        "artifact_version": {"const": "editable-receipt-v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["page_number", "status", "material_bundle", "generation", "qa", "editable_receipt"],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "comment_resolution_pending", "comment_resolution_blocked", "material_resolution_pending", "material_ready", "material_blocked", "generated", "qa_passed", "editable", "blocked", "complete"]},
        "material_bundle": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/materialRef"}]},
        "generation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/generationRef"}]},
        "qa": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/qaRef"}]},
        "editable_receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/editableRef"}]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow_contract_version", "geometry_contract_version",
    "prompt_contract_version", "qa_policy_version", "reconstruction_version",
    "fixed_layer_version", "project_name", "style_execution", "pages"
  ],
  "properties": {
    "schema_version": {"const": "4.0"},
    "workflow_contract_version": {"const": "word-ppt-workflow-v4"},
    "geometry_contract_version": {"const": "fixed-canvas-cm-v2"},
    "prompt_contract_version": {"const": "page-prompt-v8"},
    "qa_policy_version": {"const": "risk-qa-v5"},
    "reconstruction_version": {"const": "editable-image-v3"},
    "fixed_layer_version": {"const": "native-layer-v3"},
    "project_name": {"type": "string", "minLength": 1},
    "style_execution": {"$ref": "#/$defs/styleExecution"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  }
}
