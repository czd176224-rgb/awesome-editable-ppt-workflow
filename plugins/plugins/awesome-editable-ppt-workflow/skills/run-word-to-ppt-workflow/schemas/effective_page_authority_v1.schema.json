{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective_page_authority_v1.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visualDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "target", "action", "value"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"enum": ["visual.image_rendering", "visual.image_ratio", "visual.layout"]},
        "action": {"const": "set"},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "materialDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "target", "action", "material_id"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"enum": ["material.page_image", "material.attachment", "material.search_evidence"]},
        "action": {"const": "require"},
        "material_id": {"type": "string", "minLength": 1}
      }
    },
    "enterpriseMaterialDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "target", "action", "material_id", "parent_directive_id", "entity", "query", "material_role"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"const": "material.search_evidence"},
        "action": {"const": "require"},
        "material_id": {"type": "string", "pattern": "^search-request-[0-9a-f]{16}$"},
        "parent_directive_id": {"type": "string", "minLength": 1},
        "entity": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "material_role": {"const": "enterprise_logo"}
      }
    },
    "approvedDirective": {
      "oneOf": [
        {"$ref": "#/$defs/visualDirective"},
        {"$ref": "#/$defs/materialDirective"},
        {"$ref": "#/$defs/enterpriseMaterialDirective"}
      ]
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "directive_id", "target", "detail"],
      "properties": {
        "code": {"enum": ["fixed_layer_override_rejected", "word_fact_override_rejected"]},
        "directive_id": {"type": "string", "minLength": 1},
        "target": {
          "enum": [
            "word.body_text", "word.facts", "word.tables", "fixed.body_geometry", "fixed.page_title",
            "fixed.logo", "fixed.footer", "fixed.page_number"
          ]
        },
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "blockingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "directive_id", "target", "material_id"],
      "properties": {
        "code": {"const": "required_material_missing"},
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"enum": ["material.page_image", "material.attachment", "material.search_evidence"]},
        "material_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "page_number",
    "precedence",
    "fixed_hard_rules",
    "authoritative_content",
    "required_directives",
    "effective_visual_contract",
    "evidence_material",
    "rejected_overrides",
    "readiness",
    "sealed_sha256"
  ],
  "properties": {
    "artifact_version": {"const": "effective-page-authority-v1"},
    "page_number": {"type": "integer", "minimum": 1},
    "precedence": {
      "type": "array",
      "prefixItems": [
        {"const": "fixed_hard_rules"},
        {"const": "word_facts"},
        {"const": "page_comments"},
        {"const": "ui_global_soft_style"},
        {"const": "evidence_material"},
        {"const": "model_creativity"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "fixed_hard_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_width_px", "body_height_px", "logo_in_body", "fixed_layers_outside_body"],
      "properties": {
        "body_width_px": {"const": 1904},
        "body_height_px": {"const": 896},
        "logo_in_body": {"const": false},
        "fixed_layers_outside_body": {
          "type": "array",
          "prefixItems": [
            {"const": "page_title"},
            {"const": "logo"},
            {"const": "footer"},
            {"const": "page_number"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "authoritative_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_text", "tables"],
      "properties": {
        "body_text": {"type": "string"},
        "tables": {"type": "array"}
      }
    },
    "required_directives": {"type": "array", "items": {"$ref": "#/$defs/approvedDirective"}},
    "effective_visual_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_rendering", "image_ratio", "layout"],
      "properties": {
        "image_rendering": {"type": "string", "minLength": 1},
        "image_ratio": {"type": "string", "minLength": 1},
        "layout": {"type": "string", "minLength": 1}
      }
    },
    "evidence_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_images", "attachment_evidence", "search_evidence"],
      "properties": {
        "page_images": {"type": "array"},
        "attachment_evidence": {"type": "array"},
        "search_evidence": {"type": "array"}
      }
    },
    "rejected_overrides": {"type": "array", "items": {"$ref": "#/$defs/rejection"}},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_reasons"],
      "properties": {
        "status": {"enum": ["ready", "blocked"]},
        "blocking_reasons": {"type": "array", "items": {"$ref": "#/$defs/blockingReason"}}
      }
    },
    "sealed_sha256": {"$ref": "#/$defs/sha256"}
  }
}
