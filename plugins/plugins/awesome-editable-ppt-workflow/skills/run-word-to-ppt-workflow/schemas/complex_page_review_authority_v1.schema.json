{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_page_review_authority_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "page_number", "source_snapshot_sha256",
    "workspace_identity_sha256", "material_view_sha256", "director_authority_sha256",
    "candidate", "review_input_receipt", "decision", "problems", "model",
    "model_provider", "effort", "usage", "runtime_trace", "thread_id", "turn_id",
    "duration_seconds", "evidence_call_identity", "key_id", "hmac_sha256"
  ],
  "properties": {
    "schema_version": {"const": "awesome-independent-visual-review-authority-v1"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "page_number": {"type": "integer", "minimum": 1},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "workspace_identity_sha256": {"$ref": "#/$defs/sha"},
    "material_view_sha256": {"$ref": "#/$defs/sha"},
    "director_authority_sha256": {"$ref": "#/$defs/sha"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "path", "sha256", "request_identity"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "request_identity": {"$ref": "#/$defs/sha"}
      }
    },
    "review_input_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "decision": {"enum": ["accept", "correct"]},
    "problems": {
      "type": "array", "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "detail"],
        "properties": {
          "category": {"enum": ["technical_output", "fixed_layer_violation", "clear_subject_departure", "misleading_fabrication", "severe_identity_distortion", "core_comment_absent", "unusable_17_8_composition"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "model": {"type": "string", "minLength": 1},
    "model_provider": {"type": "string", "minLength": 1},
    "effort": {"type": ["string", "null"]},
    "usage": {"type": "object"},
    "runtime_trace": {"type": "object"},
    "thread_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "evidence_call_identity": {"$ref": "#/$defs/sha"},
    "key_id": {"type": "string", "minLength": 1},
    "hmac_sha256": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "accept"}}}, "then": {"properties": {"problems": {"maxItems": 0}}}, "else": {"properties": {"problems": {"minItems": 1}}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
