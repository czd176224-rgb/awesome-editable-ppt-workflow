{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page_material_bundle_v4.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "directiveDecision": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["target", "action", "value"],
          "properties": {
            "target": {"enum": ["visual.image_rendering", "visual.image_ratio", "visual.layout", "word.body_text", "word.facts", "word.tables", "fixed.body_geometry", "fixed.page_title", "fixed.logo", "fixed.footer", "fixed.page_number"]},
            "action": {"enum": ["set", "replace"]},
            "value": {}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["target", "action", "material_id"],
          "properties": {
            "target": {"enum": ["material.page_image", "material.attachment", "material.search_evidence"]},
            "action": {"const": "require"},
            "material_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["target", "action", "material_id", "directive_id", "parent_directive_id", "entity", "query", "material_role"],
          "properties": {
            "target": {"const": "material.search_evidence"}, "action": {"const": "require"},
            "material_id": {"type": "string", "minLength": 1},
            "directive_id": {"type": "string", "minLength": 1},
            "parent_directive_id": {"type": "string", "minLength": 1},
            "entity": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1},
            "material_role": {"const": "enterprise_logo"}
          }
        }
      ]
    },
    "authorityDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "kind", "text", "decisions"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["visual_override", "material_requirement", "content_override", "fixed_override", "mixed", "note"]},
        "text": {"type": "string", "minLength": 1},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/directiveDecision"}}
      }
    },
    "resolutionReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_version", "source_comment_id", "raw_comment_sha256", "directive_id", "closed_directive_sha256", "resolution_mode", "role"],
      "properties": {
        "receipt_version": {"const": "comment-resolution-receipt-v1"},
        "source_comment_id": {"type": "string", "minLength": 1},
        "raw_comment_sha256": {"$ref": "#/$defs/sha256"},
        "directive_id": {"type": "string", "minLength": 1},
        "closed_directive_sha256": {"$ref": "#/$defs/sha256"},
        "resolution_mode": {"const": "deterministic"},
        "role": {"const": "comment-resolution"}
      }
    },
    "requiredDirective": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["directive_id", "target", "action", "value"],
          "properties": {
            "directive_id": {"type": "string", "minLength": 1},
            "target": {"enum": ["visual.image_rendering", "visual.image_ratio", "visual.layout"]},
            "action": {"const": "set"}, "value": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["directive_id", "target", "action", "material_id"],
          "properties": {
            "directive_id": {"type": "string", "minLength": 1},
            "target": {"enum": ["material.page_image", "material.attachment", "material.search_evidence"]},
            "action": {"const": "require"}, "material_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["directive_id", "target", "action", "material_id", "parent_directive_id", "entity", "query", "material_role"],
          "properties": {
            "directive_id": {"type": "string", "minLength": 1}, "target": {"const": "material.search_evidence"},
            "action": {"const": "require"}, "material_id": {"type": "string", "minLength": 1},
            "parent_directive_id": {"type": "string", "minLength": 1}, "entity": {"type": "string", "minLength": 1},
            "query": {"type": "string", "minLength": 1}, "material_role": {"const": "enterprise_logo"}
          }
        }
      ]
    },
    "supersededDirective": {
      "type": "object", "additionalProperties": false,
      "required": ["directive_id", "target", "action", "value", "superseded_by_directive_id"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"enum": ["visual.image_rendering", "visual.image_ratio", "visual.layout"]},
        "action": {"const": "set"}, "value": {"type": "string", "minLength": 1},
        "superseded_by_directive_id": {"type": "string", "minLength": 1}
      }
    },
    "blockingReason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "directive_id", "target", "material_id"],
      "properties": {
        "code": {"enum": ["required_search_material_unavailable", "required_page_image_unavailable", "required_attachment_unavailable"]},
        "directive_id": {"type": "string", "minLength": 1},
        "target": {"enum": ["material.page_image", "material.attachment", "material.search_evidence"]},
        "material_id": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "rows"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "rows": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "commentIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "intent_type", "text", "source_comment_id"],
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "intent_type": {"enum": ["requirement", "search_request", "note"]},
        "text": {"type": "string", "minLength": 1},
        "source_comment_id": {"type": "string", "minLength": 1},
        "material_id": {"type": "string", "pattern": "^search-request-[0-9a-f]{16}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"intent_type": {"const": "search_request"}}, "required": ["intent_type"]},
          "then": {"required": ["material_id"]},
          "else": {"not": {"required": ["material_id"]}}
        }
      ]
    },
    "attachmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "asset_id", "path", "sha256", "media_type", "content", "content_sha256", "content_truncated", "original_char_count", "source_byte_count", "normalized_byte_count", "content_limit_chars", "decoded_encoding"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"const": "text/plain"},
        "content": {"type": "string", "minLength": 1, "maxLength": 20000},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "content_truncated": {"type": "boolean"},
        "original_char_count": {"type": "integer", "minimum": 1},
        "source_byte_count": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "normalized_byte_count": {"type": "integer", "minimum": 1},
        "content_limit_chars": {"const": 20000},
        "decoded_encoding": {"enum": ["utf-8", "utf-8-sig", "utf-16", "utf-16-le", "utf-16-be"]}
      }
    },
    "searchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "asset_id", "query", "source_url", "excerpt", "retrieved_at", "sha256"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "pattern": "^search-request-[0-9a-f]{16}$"},
        "query": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "minLength": 1},
        "excerpt": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "direct_image_url": {"type": "string", "format": "uri", "minLength": 1},
        "final_image_url": {"type": "string", "format": "uri", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "media_type": {"enum": ["image/jpeg", "image/png", "image/webp"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 12000},
        "height": {"type": "integer", "minimum": 1, "maximum": 12000},
        "material_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "digest", "signature"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "digest": {"$ref": "#/$defs/sha256"},
            "signature": {"$ref": "#/$defs/sha256"}
          }
        },
        "directive_id": {"type": "string", "minLength": 1},
        "parent_directive_id": {"type": "string", "minLength": 1},
        "entity": {"type": "string", "minLength": 1},
        "material_role": {"const": "enterprise_logo"},
        "matched_entities": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "presence_policy": {"const": "required_presence"}
      },
      "allOf": [{
        "if": {"required": ["material_role"]},
        "then": {"required": ["directive_id", "parent_directive_id", "entity", "material_role", "matched_entities", "presence_policy", "local_path", "media_type", "material_attestation"]}
      }]
    },
    "normalizedGlobalDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive", "asset_id"],
      "properties": {
        "directive": {"const": "require_page_image"},
        "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "directive_type", "asset_id", "raw"],
      "properties": {
        "source": {"enum": ["page_comment", "global_style"]},
        "directive_type": {"const": "require_page_image"},
        "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "raw": {
          "oneOf": [
            {"type": "string", "pattern": "^\\[require-page-image:[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\]$"},
            {"$ref": "#/$defs/normalizedGlobalDirective"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "page_comment"}}},
          "then": {"properties": {"raw": {"type": "string"}}}
        },
        {
          "if": {"properties": {"source": {"const": "global_style"}}},
          "then": {"properties": {"raw": {"$ref": "#/$defs/normalizedGlobalDirective"}}}
        }
      ]
    },
    "visualContract": {
      "type": "object", "additionalProperties": false, "required": ["hard_constraints", "soft_preferences", "creative_freedom"],
      "properties": {
        "hard_constraints": {"type": "object", "additionalProperties": false, "required": ["content_fidelity", "one_page_to_one_slide", "title_color", "palette", "typography"], "properties": {"content_fidelity": {"const": "preserve_information_and_logic"}, "one_page_to_one_slide": {"const": true}, "title_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "palette": {"type": "object"}, "typography": {"type": "object"}}},
        "soft_preferences": {"type": "object", "additionalProperties": false, "required": ["direction", "template_selection", "visual_style", "color", "icons", "typography", "image_rendering", "style_axes", "layout_preferences", "information_density", "regional_style", "background_system", "image_role", "evidence_strength", "composition_tendency", "brand_device", "additional_requirements"], "properties": {"direction": {"type": "integer", "minimum": 0}, "template_selection": {"type": "object"}, "visual_style": {"type": "string", "minLength": 1}, "color": {"type": "object"}, "icons": {"type": "string", "minLength": 1}, "typography": {"type": "object"}, "image_rendering": {"type": "object"}, "style_axes": {"type": "object"}, "layout_preferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "information_density": {"enum": ["low", "balanced", "high"]}, "regional_style": {"type": "object"}, "background_system": {"enum": ["light", "dark", "mixed", "light-with-dark-highlights"]}, "image_role": {"type": "object"}, "evidence_strength": {"enum": ["business", "data-case", "strict"]}, "composition_tendency": {"enum": ["auto", "formal-consulting", "brand-editorial", "technical-rd", "product-launch"]}, "brand_device": {"enum": ["none", "light", "medium", "strong"]}, "additional_requirements": {"type": "string", "maxLength": 2000}}},
        "creative_freedom": {"type": "object", "additionalProperties": false, "required": ["layout", "composition", "visual_hierarchy", "content_visualization", "page_specific_emphasis"], "properties": {"layout": {"const": true}, "composition": {"const": true}, "visual_hierarchy": {"const": true}, "content_visualization": {"const": true}, "page_specific_emphasis": {"const": true}}}
      }
    },
    "pageImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "sha256", "media_type", "presence_policy", "promotion"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "pattern": "^image/"},
        "source_role": {"enum": ["page_image", "image_attachment"]},
        "presence_policy": {"enum": ["reference_only", "required_presence"]},
        "promotion": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/promotion"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"presence_policy": {"const": "reference_only"}}},
          "then": {"properties": {"promotion": {"type": "null"}}}
        },
        {
          "if": {"properties": {"presence_policy": {"const": "required_presence"}}},
          "then": {"properties": {"promotion": {"$ref": "#/$defs/promotion"}}}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version", "workflow_contract_version", "page_number", "source_text", "source_hash", "authoritative_content",
    "style_execution", "page_images", "required_presence_asset_ids", "comment_intents",
    "resolved_directives", "effective_page_authority", "required_directives", "superseded_directives", "generation_readiness",
    "attachment_evidence", "search_evidence", "material_summary", "provenance",
    "bundle_attestation_signature", "sealed_sha256"
  ],
  "properties": {
    "artifact_version": {"const": "page-material-bundle-v4"},
    "workflow_contract_version": {"const": "word-ppt-workflow-v4"},
    "page_number": {"type": "integer", "minimum": 1},
    "source_text": {"type": "string", "minLength": 1},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "authoritative_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_text", "tables"],
      "properties": {
        "body_text": {"type": "string"},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}}
      }
    },
    "style_execution": {"$ref": "#/$defs/artifact"},
    "page_images": {"type": "array", "items": {"$ref": "#/$defs/pageImage"}},
    "required_presence_asset_ids": {
      "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
    },
    "comment_intents": {"type": "array", "items": {"$ref": "#/$defs/commentIntent"}},
    "resolved_directives": {"type": "array", "items": {"$ref": "#/$defs/authorityDirective"}},
    "effective_page_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_version", "page_number", "precedence", "fixed_hard_rules", "authoritative_content", "required_directives", "superseded_directives", "effective_visual_contract", "evidence_material", "rejected_overrides", "readiness", "sealed_sha256"],
      "properties": {
        "artifact_version": {"const": "effective-page-authority-v3"},
        "page_number": {"type": "integer", "minimum": 1},
        "precedence": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
        "fixed_hard_rules": {"type": "object"},
        "authoritative_content": {"type": "object"},
        "required_directives": {"type": "array", "items": {"$ref": "#/$defs/requiredDirective"}},
        "superseded_directives": {"type": "array", "items": {"$ref": "#/$defs/supersededDirective"}},
        "effective_visual_contract": {"$ref": "#/$defs/visualContract"},
        "evidence_material": {"type": "object"},
        "rejected_overrides": {"type": "array"},
        "readiness": {"type": "object"},
        "sealed_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "required_directives": {"type": "array", "items": {"$ref": "#/$defs/requiredDirective"}},
    "superseded_directives": {"type": "array", "items": {"$ref": "#/$defs/supersededDirective"}},
    "generation_readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["ready", "code", "directive_ids", "blocking_reasons"],
      "properties": {
        "ready": {"type": "boolean"},
        "code": {"enum": ["ready", "required_search_material_unavailable", "required_page_image_unavailable", "required_attachment_unavailable"]},
        "directive_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blocking_reasons": {"type": "array", "items": {"$ref": "#/$defs/blockingReason"}}
      }
    },
    "attachment_evidence": {"type": "array", "items": {"$ref": "#/$defs/attachmentEvidence"}},
    "search_evidence": {"type": "array", "items": {"$ref": "#/$defs/searchEvidence"}},
    "material_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["counts", "identities_sha256"],
      "properties": {
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["page_images", "attachments", "search_results"],
          "properties": {
            "page_images": {"type": "integer", "minimum": 0},
            "attachments": {"type": "integer", "minimum": 0},
            "search_results": {"type": "integer", "minimum": 0}
          }
        },
        "identities_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "source_sha256", "page_contract_sha256", "logo_sha256", "raw_page_comments", "resolution_receipts", "comment_resolution_artifact"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "page_contract_sha256": {"$ref": "#/$defs/sha256"},
        "logo_sha256": {"$ref": "#/$defs/sha256"},
        "raw_page_comments": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["comment_id", "text", "author", "timestamp"],
            "properties": {
              "comment_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "author": {"type": "string"},
              "timestamp": {"type": ["string", "null"]}
            }
          }
        },
        "resolution_receipts": {"type": "array", "items": {"$ref": "#/$defs/resolutionReceipt"}},
        "comment_resolution_artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "page_entry_sha256", "page_entry_signature", "page_contract_sha256", "page_lock_sha256", "raw_comments_sha256"],
          "properties": {
            "path": {"const": "confirm_ui/page_requirement_summary.json"},
            "page_entry_sha256": {"$ref": "#/$defs/sha256"},
            "page_entry_signature": {"$ref": "#/$defs/sha256"},
            "page_contract_sha256": {"$ref": "#/$defs/sha256"},
            "page_lock_sha256": {"$ref": "#/$defs/sha256"},
            "raw_comments_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "bundle_attestation_signature": {"$ref": "#/$defs/sha256"},
    "sealed_sha256": {"$ref": "#/$defs/sha256"}
  }
}
